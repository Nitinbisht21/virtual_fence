# ==============================================================================
# Virtual Fence Map Builder - Environment Configuration
# ==============================================================================

# MongoDB Connection Configuration
# Open MongoDB Compass and paste this connection string:
#   - Local MongoDB: mongodb://localhost:27017
#   - MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net
MONGODB_URI=mongodb://localhost:27017

# MongoDB Database Name (Compass will display this database and its collections)
MONGODB_DB_NAME=virtual_fence

# Application Server Port
PORT=5000
